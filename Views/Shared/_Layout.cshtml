<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Control System</title>
    <meta name="description" content="Inventory & Stock Control System - Manage your products, warehouses and stock movements." />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-wrapper">

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div>
                <div class="brand-name">InvenTrack</div>
                <div class="brand-sub">Stock Control System</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-label">Main Menu</div>
            <ul class="nav flex-column" id="sidebarNav">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")"
                       asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")"
                       asp-controller="Products" asp-action="Index">
                        <i class="bi bi-archive"></i>
                        <span>Products</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categories" ? "active" : "")"
                       asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-tags"></i>
                        <span>Categories</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Warehouses" ? "active" : "")"
                       asp-controller="Warehouses" asp-action="Index">
                        <i class="bi bi-building"></i>
                        <span>Warehouses</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "StockMovements" ? "active" : "")"
                       asp-controller="StockMovements" asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Stock Movements</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-label" style="margin-top:1rem;">Account</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-person-circle"></i>
                        <span>My Profile</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Dashboard", new { area = "" })" method="post">
                <button type="submit" class="nav-link w-100 border-0 bg-transparent text-start">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="main-content">

        <!-- Topbar -->
        <div class="topbar">
            <button class="topbar-btn d-md-none border-0" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>
            <div class="topbar-title">@(ViewData["Title"] ?? "Dashboard")</div>
            <div class="topbar-actions">
                <div class="topbar-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </div>
                <div class="user-avatar" title="Account">
                    <i class="bi bi-person-fill" style="font-size:15px;"></i>
                </div>
            </div>
        </div>

        <!-- Page Body -->
        <div class="page-content">
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer style="padding:.75rem 1.5rem;border-top:1px solid #e2e8f0;font-size:12px;color:#94a3b8;background:#fff;">
            &copy; 2026 InvenTrack &mdash; Inventory Stock Control System
        </footer>
    </div>
</div>

<!-- jQuery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<!-- Bootstrap 5 -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- DataTables -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

<script>
    $(document).ready(function () {
        // Init DataTables
        $('.datatable').DataTable({
            responsive: true,
            language: {
                search: '<i class="bi bi-search"></i>',
                searchPlaceholder: 'Search...',
                lengthMenu: 'Show _MENU_ entries',
                info: 'Showing _START_ to _END_ of _TOTAL_ records',
                paginate: { previous: '<i class="bi bi-chevron-left"></i>', next: '<i class="bi bi-chevron-right"></i>' }
            },
            dom: '<"d-flex align-items-center justify-content-between mb-3"lf>rt<"d-flex align-items-center justify-content-between mt-3"ip>'
        });

        // Mobile sidebar toggle
        $('#sidebarToggle').on('click', function () {
            $('#sidebar').toggleClass('open');
        });

        // Auto-dismiss alerts
        setTimeout(function () { $('.alert-dismissible').alert('close'); }, 4000);
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

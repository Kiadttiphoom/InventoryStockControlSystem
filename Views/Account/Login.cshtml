@model InventoryStockControlSystem.Controllers.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 400px;
            padding: 2rem;
        }
        .form-control {
            background-color: #0f172a;
            border: 1px solid #334155;
            color: #f8fafc;
        }
        .form-control:focus {
            background-color: #0f172a;
            border-color: #6366f1;
            color: #f8fafc;
            box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.25);
        }
        .btn-primary {
            background-color: #6366f1;
            border-color: #6366f1;
        }
        .btn-primary:hover {
            background-color: #4f46e5;
            border-color: #4f46e5;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                <i class="bi bi-box-seam" style="font-size: 30px; color: white;"></i>
            </div>
            <h4 class="fw-bold">Inventory System</h4>
            <p class="text-muted" style="font-size: 14px;">Sign in to continue</p>
        </div>

        <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px;"></div>
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label" style="font-size: 13px; font-weight: 500; color: #94a3b8;">Email address</label>
                <div class="input-group">
                    <span class="input-group-text" style="background-color: #0f172a; border-color: #334155; color: #64748b;"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" value="admin@inventory.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label" style="font-size: 13px; font-weight: 500; color: #94a3b8;">Password</label>
                <div class="input-group">
                    <span class="input-group-text" style="background-color: #0f172a; border-color: #334155; color: #64748b;"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" value="Admin@123456" />
                </div>
                <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" style="background-color: #0f172a; border-color: #334155;" />
                <label asp-for="RememberMe" class="form-check-label" style="font-size: 13px; color: #cbd5e1;">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mt-2">Sign In</button>
        </form>
    </div>
</body>
</html>

@using InventoryStockControlSystem.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-plus-circle me-2"></i>Create Product</h1>
        <div class="breadcrumb">Products &rsaquo; Create</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-info-circle me-2 text-primary-custom"></i>Product Information</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label">Product Code <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control" placeholder="e.g. PRD-001" />
                            <span asp-validation-for="Code" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">Product Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select"
                                    asp-items="@(new SelectList((IEnumerable<InventoryStockControlSystem.Models.Category>)ViewBag.Categories, "Id", "Name"))">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Unit" class="form-label">Unit</label>
                            <input asp-for="Unit" class="form-control" placeholder="e.g. pcs, kg, box" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="UnitPrice" class="form-label">Unit Price <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="font-size:13px;">฿</span>
                                <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                            <input asp-for="ReorderLevel" type="number" min="0" class="form-control" placeholder="0" />
                            <span asp-validation-for="ReorderLevel" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReorderQuantity" class="form-label">Reorder Qty</label>
                            <input asp-for="ReorderQuantity" type="number" min="0" class="form-control" placeholder="0" />
                            <span asp-validation-for="ReorderQuantity" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input type="checkbox" asp-for="IsActive" class="form-check-input" id="isActiveSwitch" />
                                <label class="form-check-label" for="isActiveSwitch">
                                    Product is <strong>Active</strong>
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1.25rem 0;border-color:#e2e8f0;" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Create Product
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-lightbulb me-2 text-warning"></i>Tips</h5>
            </div>
            <div class="card-body" style="font-size:13px;color:#64748b;line-height:1.8;">
                <ul class="list-unstyled mb-0">
                    <li><i class="bi bi-check text-success me-2"></i>Product Code must be unique</li>
                    <li><i class="bi bi-check text-success me-2"></i>Reorder Level triggers low-stock alert</li>
                    <li><i class="bi bi-check text-success me-2"></i>Inactive products won't appear in stock movements</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

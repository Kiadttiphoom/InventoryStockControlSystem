@using InventoryStockControlSystem.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-pencil-square me-2"></i>Edit Product</h1>
        <div class="breadcrumb">Products &rsaquo; Edit &rsaquo; @Model.Code</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-info-circle me-2 text-primary-custom"></i>Product Information</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label">Product Code <span class="text-danger">*</span></label>
                            <input asp-for="Code" class="form-control" />
                            <span asp-validation-for="Code" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">Product Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select"
                                    asp-items="@(new SelectList((IEnumerable<InventoryStockControlSystem.Models.Category>)ViewBag.Categories, "Id", "Name"))">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Unit" class="form-label">Unit</label>
                            <input asp-for="Unit" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="UnitPrice" class="form-label">Unit Price <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="font-size:13px;">฿</span>
                                <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger" style="font-size:12px;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                            <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ReorderQuantity" class="form-label">Reorder Qty</label>
                            <input asp-for="ReorderQuantity" type="number" min="0" class="form-control" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input type="checkbox" asp-for="IsActive" class="form-check-input" id="isActiveSwitch" />
                                <label class="form-check-label" for="isActiveSwitch">Product is <strong>Active</strong></label>
                            </div>
                        </div>
                    </div>

                    <hr style="margin:1.25rem 0;border-color:#e2e8f0;" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                            <i class="bi bi-eye"></i> View Details
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
